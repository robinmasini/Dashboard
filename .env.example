# TradeView & Dashboard Environment Variables Example
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_ADMIN_EMAIL=admin@example.com
VITE_RUST_SERVER_URL=http://localhost:8080
VITE_RUST_WS_URL=ws://localhost:8080/ws

# TradeView engine. Hosted, this becomes wss://<host>/ws and the token is
# required — the socket accepts orders.
VITE_TRADEVIEW_WS_URL=ws://localhost:8080/ws
VITE_TRADEVIEW_API_TOKEN=
