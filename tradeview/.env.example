# Interactive Brokers connection.
# IB Gateway : 4002 (paper) / 4001 (live)
# TWS        : 7497 (paper) / 7496 (live)
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=1

# Seconds before a silent socket is declared unreachable.
IB_CONNECT_TIMEOUT_SECS=10
# Seconds without a tick before the feed is called stale.
IB_STALE_AFTER_SECS=30

# CME symbol to probe. MES = Micro E-mini S&P 500.
IB_SYMBOL=MES

# Where prices come from: SYNTHETIC (invented, the default) or IBKR (live feed).
TRADEVIEW_MARKET_SOURCE=SYNTHETIC
# Contracts to stream, comma separated.
TRADEVIEW_SYMBOLS=MES,MNQ

# REALTIME needs a paid CME subscription; DELAYED is free and ~10 minutes
# behind — useful to prove the pipeline, useless to trade on.
IB_FEED_KIND=REALTIME

# Public market news, as Label=url pairs separated by |. Defaults to the
# feeds verified to return a usable number of items.
# TRADEVIEW_NEWS_FEEDS=CNBC=https://www.cnbc.com/id/20910258/device/rss/rss.html
